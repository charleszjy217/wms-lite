{
  "name": "wms-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "packages/shared",
    "integrations",
    "integrations/*",
    "tests/load"
  ],
  "scripts": {
    "test": "npm -ws --if-present test",
    "test:backend": "npm -w backend test",
    "test:frontend": "npm -w frontend test",
    "build": "npm -ws --if-present build",
    "build:backend": "npm -w backend build",
    "build:frontend": "npm -w frontend build",
    "lint": "npm -ws --if-present lint",
    "clean": "npm -ws --if-present clean"
  },
  "overrides": {
    "multer": "2.2.0",
    "path-to-regexp": "8.4.2"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
