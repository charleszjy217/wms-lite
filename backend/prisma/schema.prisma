// ============================================================================
// WMS-lite — Prisma Schema
// ============================================================================
// All entities for the Warehouse Management System lite version.
// Conventions:
//   - UUID primary keys
//   - snake_case column names via @map
//   - snake_case table names via @@map
//   - createdAt / updatedAt on mutable entities
//   - Cascade / Restrict / SetNull policies documented per relation
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. Product & Category
// ============================================================================

model ProductCategory {
  id       String    @id @default(uuid()) @db.Uuid
  code     String    @unique
  name     String
  parentId String?   @map("parent_id") @db.Uuid
  path     String

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([path])
  @@map("product_category")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  skuCode        String   @unique @map("sku_code")
  name           String
  description    String?
  categoryId     String?  @map("category_id") @db.Uuid
  brand          String?
  unitOfMeasure  String   @map("unit_of_measure")
  barcode        String?   @unique
  specifications Json?             // 规格属性 — flexible key/value pairs
  status         String   @default("ACTIVE")

  category ProductCategory? @relation(fields: [categoryId], references: [id])

  batches             Batch[]
  stockMovements      StockMovement[]
  inventoryBalances   InventoryBalance[]
  productPrices       ProductPrice[]
  priceChangeLogs     PriceChangeLog[]
  receivingOrderItems ReceivingOrderItem[]
  transferItems       TransferItem[]
  stocktakeItems      StocktakeItem[]
  batches           Batch[]
  stockMovements    StockMovement[]
  inventoryBalances InventoryBalance[]
  productPrices     ProductPrice[]
  priceChangeLogs   PriceChangeLog[]
  transferItems     TransferItem[]
  stocktakeItems    StocktakeItem[]
