// ============================================================================
// WMS-lite — Prisma Schema
// ============================================================================
// All entities for the Warehouse Management System lite version.
// Conventions:
//   - UUID primary keys
//   - snake_case column names via @map
//   - snake_case table names via @@map
//   - createdAt / updatedAt on mutable entities
//   - Cascade / Restrict / SetNull policies documented per relation
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. Product & Category
// ============================================================================

model ProductCategory {
  id       String    @id @default(uuid()) @db.Uuid
  code     String    @unique
  name     String
  parentId String?   @map("parent_id") @db.Uuid
  path     String

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([path])
  @@map("product_category")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  skuCode        String   @unique @map("sku_code")
  name           String
  description    String?
  categoryId     String?  @map("category_id") @db.Uuid
  brand          String?
  unitOfMeasure  String   @map("unit_of_measure")
  barcode        String?   @unique
  specifications Json?             // 规格属性 — flexible key/value pairs
  status         String   @default("ACTIVE")

  category ProductCategory? @relation(fields: [categoryId], references: [id])

  batches             Batch[]
  stockMovements      StockMovement[]
  inventoryBalances   InventoryBalance[]
  productPrices       ProductPrice[]
  priceChangeLogs     PriceChangeLog[]
  receivingOrderItems ReceivingOrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([status])
  @@map("product")
}

// ============================================================================
// 2. Warehouse, Zone & Location (hierarchy: Warehouse → Zone → Location)
// ============================================================================

model Warehouse {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  name    String
  type    String @default("PHYSICAL")
  address String?
  status  String @default("ACTIVE")

  zones Zone[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("warehouse")
}

model Zone {
  id          String @id @default(uuid()) @db.Uuid
  code        String
  name        String
  warehouseId String @map("warehouse_id") @db.Uuid
  status      String @default("ACTIVE")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  locations Location[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([code, warehouseId])
  @@index([warehouseId])
  @@index([status])
  @@map("zone")
}

model Location {
  id          String  @id @default(uuid()) @db.Uuid
  code        String
  zoneId      String  @map("zone_id") @db.Uuid
  barcode     String?
  status      String  @default("ACTIVE")
  maxCapacity Float?  @map("max_capacity")

  zone Zone @relation(fields: [zoneId], references: [id])

  outgoingMovements StockMovement[] @relation("FromLocation")
  incomingMovements StockMovement[] @relation("ToLocation")
  inventoryBalances InventoryBalance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([code, zoneId])
  @@index([zoneId])
  @@index([status])
  @@index([barcode])
  @@map("location")
}

// ============================================================================
// 3. Batch (批次 — production-date tracking)
// ============================================================================

model Batch {
  id             String   @id @default(uuid()) @db.Uuid
  batchNo        String   @map("batch_no")
  productId      String   @map("product_id") @db.Uuid
  productionDate DateTime? @map("production_date")
  expiryDate     DateTime? @map("expiry_date")
  status         String   @default("ACTIVE")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  stockMovements      StockMovement[]
  inventoryBalances   InventoryBalance[]
  receivingOrderItems ReceivingOrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([batchNo, productId])
  @@index([productId])
  @@index([expiryDate])
  @@index([status])
  @@map("batch")
}

// ============================================================================
// 3b. Receiving Order (收货单)
// ============================================================================

model ReceivingOrder {
  id          String   @id @default(uuid()) @db.Uuid
  referenceNo String   @unique @map("reference_no")
  status      String   @default("DRAFT")          // DRAFT → SUBMITTED → COMPLETED / CANCELLED
  warehouseId String   @map("warehouse_id") @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  operator    String
  notes       String?
  receiptDate DateTime? @map("receipt_date")

  items ReceivingOrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([referenceNo])
  @@index([warehouseId])
  @@index([locationId])
  @@map("receiving_order")
}

model ReceivingOrderItem {
  id               String    @id @default(uuid()) @db.Uuid
  receivingOrderId String    @map("receiving_order_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  batchId          String?   @map("batch_id") @db.Uuid
  batchNo          String    @map("batch_no")
  productionDate   DateTime? @map("production_date")
  expiryDate       DateTime? @map("expiry_date")
  quantity         Float

  receivingOrder ReceivingOrder @relation(fields: [receivingOrderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch          Batch?         @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([receivingOrderId])
  @@index([productId])
  @@index([batchId])
  @@map("receiving_order_item")
}

// ============================================================================
// 4. Stock Movement (库存流水) — immutable ledger
// ============================================================================

model StockMovement {
  id             String   @id @default(uuid()) @db.Uuid
  type           String   @map("type")          // INBOUND | OUTBOUND | TRANSFER | ADJUSTMENT
  productId      String   @map("product_id") @db.Uuid
  batchId        String   @map("batch_id") @db.Uuid
  fromLocationId String?  @map("from_location_id") @db.Uuid
  toLocationId   String?  @map("to_location_id") @db.Uuid
  quantity       Float                             // positive for inbound, negative for outbound
  referenceNo    String?  @map("reference_no")
  operator       String
  reason         String?

  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch        Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  fromLocation Location? @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location? @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([batchId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([type])
  @@index([referenceNo])
  @@index([createdAt])
  @@map("stock_movement")
}

// ============================================================================
// 5. Inventory Balance (库存余额) — product × location × batch snapshot
// ============================================================================

model InventoryBalance {
  id         String @id @default(uuid()) @db.Uuid
  productId  String @map("product_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  batchId    String @map("batch_id") @db.Uuid
  quantity   Float  @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, locationId, batchId])
  @@index([productId])
  @@index([locationId])
  @@index([batchId])
  @@map("inventory_balance")
}

// ============================================================================
// 6. Price List & Product Price
// ============================================================================

model PriceList {
  id     String @id @default(uuid()) @db.Uuid
  code   String @unique
  name   String
  status String @default("ACTIVE")

  productPrices ProductPrice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([status])
  @@map("price_list")
}

model ProductPrice {
  id            String   @id @default(uuid()) @db.Uuid
  priceListId   String   @map("price_list_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  unitPrice     Float    @map("unit_price")
  effectiveDate DateTime @map("effective_date")
  endDate       DateTime? @map("end_date")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  priceChangeLogs PriceChangeLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([priceListId])
  @@index([productId])
  @@index([effectiveDate, endDate])
  @@map("product_price")
}

// ============================================================================
// 7. Price Change Log (调价记录) — audit trail for price changes
// ============================================================================

model PriceChangeLog {
  id             String   @id @default(uuid()) @db.Uuid
  productPriceId String?  @map("product_price_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  oldPrice       Float    @map("old_price")
  newPrice       Float    @map("new_price")
  effectiveDate  DateTime @map("effective_date")
  operator       String
  reason         String?

  productPrice ProductPrice? @relation(fields: [productPriceId], references: [id], onDelete: SetNull)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productPriceId])
  @@index([productId])
  @@index([effectiveDate])
  @@map("price_change_log")
}

// ============================================================================
// 8. User / Role / Permission (RBAC)
// ============================================================================

model User {
  id          String @id @default(uuid()) @db.Uuid
  username    String @unique
  email       String @unique
  password    String
  displayName String? @map("display_name")
  status      String @default("ACTIVE")

  userRoles UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([username])
  @@index([email])
  @@index([status])
  @@map("user")
}

model Role {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  name        String
  description String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@map("role")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  name        String
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@map("permission")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

// ============================================================================
// 9. Audit Log (审计日志) — generic who / when / before / after
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  before     String?             // JSON snapshot before change
  after      String?             // JSON snapshot after change
  operator   String
  reason     String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([operator])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================================
// 10. Integration Endpoint & Sync Job
// ============================================================================

model IntegrationEndpoint {
  id         String @id @default(uuid()) @db.Uuid
  code       String @unique
  name       String
  url        String
  method     String @default("GET")
  headers    String?            // JSON
  authType   String? @map("auth_type")
  authConfig String? @map("auth_config") // JSON
  status     String @default("ACTIVE")

  syncJobs SyncJob[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([status])
  @@map("integration_endpoint")
}

model SyncJob {
  id           String    @id @default(uuid()) @db.Uuid
  endpointId   String    @map("endpoint_id") @db.Uuid
  status       String    @default("PENDING")  // PENDING | RUNNING | SUCCESS | FAILED
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  errorMessage String?   @map("error_message")
  result       String?                        // JSON

  endpoint IntegrationEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([endpointId])
  @@index([status])
  @@map("sync_job")
}
